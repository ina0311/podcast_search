{
  "name": "podcast-search",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all -p dev:*",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:admin-ui": "npm --workspace apps/admin-ui run dev",
    "build": "npm-run-all build:*",
    "build:api": "npm --workspace apps/api run build",
    "build:admin-ui": "npm --workspace apps/admin-ui run build"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "@types/node": "^20.11.19"
  }
} 