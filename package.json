{
  "name": "podcast-search",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "dotenvx run -f packages/config/environments/.env.development -- turbo run dev --parallel",
    "dev:api": "turbo run dev --filter=api",
    "dev:admin-ui": "turbo run dev --filter=admin-ui",
    "start:prod": "dotenvx run -f packages/config/environments/.env.production -- node apps/api/dist/index.js",
    "build": "turbo run build",
    "build:api": "turbo run build --filter=api",
    "build:api:prod": "pnpm db:generate && turbo run build --filter=api...",
    "build:admin-ui": "turbo run build --filter=admin-ui",
    "typecheck": "tsc -b -v --noEmit",
    "typecheck:watch": "tsc -b --watch",
    "typecheck:turbo": "turbo run typecheck",
    "db:migrate": "pnpm -C packages/database run prisma:migrate",
    "db:generate": "pnpm -C packages/database run prisma:generate",
    "db:deploy": "pnpm -C packages/database run prisma:deploy",
    "db:format": "pnpm -C packages/database run prisma:format",
    "db:push": "pnpm -C packages/database exec prisma db push",
    "db:seed": "dotenvx run -f packages/config/environments/.env.development -- pnpm -C packages/database run prisma:seed",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "lint": "biome lint .",
    "lint:fix": "biome lint --fix .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --fix .",
    "prepare": "husky"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "supabase",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@dotenvx/dotenvx": "^1.34.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.19",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-cucumber": "^4.5.0",
    "lint-staged": "^16.1.4",
    "npm-run-all": "^4.1.5",
    "ts-jest": "^29.4.6",
    "tsup": "^8.5.0",
    "turbo": "^2.3.0",
    "typescript": "^5.9.2"
  },
  "packageManager": "pnpm@10.27.0",
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,css}": [
      "biome check --fix --no-errors-on-unmatched"
    ]
  }
}
