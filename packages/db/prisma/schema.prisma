datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum EpisodeStatus {
  PUBLISHED
  PRIVATE
  REMOVED
  DRAFT
}

model Podcast {
  id        Int      @id @default(autoincrement())
  publicId  String   @unique @default(uuid()) @db.Uuid
  title     String
  rssUrl    String?
  author    String?
  language  String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  episodes  PodcastEpisode[]
}

model PodcastEpisode {
  id                   Int            @id @default(autoincrement())
  publicId             String         @unique @default(uuid()) @db.Uuid
  podcastId            Int
  podcast              Podcast        @relation(fields: [podcastId], references: [id])
  title                String
  enclosureUrl         String
  status               EpisodeStatus  @default(PUBLISHED)
  visibilityChangedAt  DateTime?
  publishedAt          DateTime?
  durationSec          Int?
  description          String?
  source               String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  transcripts          TranscriptSegment[]

  @@unique([podcastId, enclosureUrl])
  @@index([podcastId])
  @@index([status])
  @@index([podcastId, publishedAt])
}

model TranscriptSegment {
  id           Int            @id @default(autoincrement())
  publicId     String         @unique @default(uuid()) @db.Uuid
  episodeId    Int
  episode      PodcastEpisode @relation(fields: [episodeId], references: [id])
  text         String
  startMs      Int
  endMs        Int
  language     String?
  speakerLabel String?
  confidence   Float?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([episodeId, startMs, endMs])
  @@index([episodeId, startMs])
} 