{
  "name": "@podcast_search/database",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json --emitDeclarationOnly --declaration --outDir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:format": "prisma format",
    "prisma:seed": "tsx src/seed/index.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@podcast_search/config": "workspace:*",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "prisma": "^7.2.0"
  },
  "devDependencies": {
    "supabase": "^2.0.0",
    "tsx": "^4.19.0"
  }
}
