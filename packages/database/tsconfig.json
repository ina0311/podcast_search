{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "paths": {
      "@podcast_search/config": ["../config/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": [
