{
  "install": "./install-back-agent.sh",
  "setup": [
    "pnpm run build:packages",
    "pnpm run db:generate",
    "pnpm run db:migrate"
  ],
  "start": "pnpm run dev",
  "terminals": [
    {
      "name": "Background Services",
      "command": "./start-background-services.sh"
    },
    {
      "name": "API Server", 
      "command": "pnpm run dev:api"
    },
    {
      "name": "Admin UI",
      "command": "pnpm run dev:admin-ui"
    }
  ],
  "env": {
    "NODE_ENV": "development",
    "DATABASE_URL": "postgresql://postgres:postgres@localhost:5432/podcast",
    "QDRANT_URL": "http://localhost:6333",
    "PORT": "3001",
    "LOG_LEVEL": "info"
  },
  "services": {
    "postgresql": {
      "image": "postgres:16",
      "port": 5432,
      "env": {
        "POSTGRES_DB": "podcast",
        "POSTGRES_USER": "postgres",
        "POSTGRES_PASSWORD": "postgres"
      }
    },
    "qdrant": {
      "image": "qdrant/qdrant:latest",
      "port": 6333,
      "volumes": ["./qdrant_storage:/qdrant/storage"]
    }
  }
}