{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*development"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "format": {
      "outputs": []
    },
    "prisma:generate": {
      "cache": false,
      "outputs": ["**/prisma/generated/**"]
    },
    "prisma:migrate": {
      "cache": false
    },
    "prisma:deploy": {
      "cache": false
    },
    "prisma:format": {
      "cache": false
    },
    "prisma:seed": {
      "cache": false
    }
  }
}
